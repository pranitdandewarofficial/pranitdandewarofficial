    .footer-brand .brand-name .lokl { color: var(--orange); }
    .footer-brand .brand-name .biz  { color: var(--white); }
    .footer-brand .brand-tag { font-size: 9px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.3); margin-top: 2px; }
    .footer-desc { font-size: 13px; color: rgba(255,255,255,.4); line-height: 1.7; margin-bottom: 20px; }
    .footer-socials { display: flex; gap: 10px; flex-wrap: wrap; }
    .footer-socials a {
      width: 36px; height: 36px; border-radius: 50%;
      background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.12);
      display: flex; align-items: center; justify-content: center;
    }
    .footer-socials a { transition: background .2s, border-color .2s, transform .15s; }
    .footer-socials a:hover { background: rgba(249,115,22,.18); border-color: rgba(249,115,22,.35); transform: translateY(-1px); }
    .footer-socials svg { width: 18px; height: 18px; stroke: rgba(255,255,255,.7); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .footer-socials a:hover svg { stroke: rgba(255,255,255,.9); }
    .footer-socials .wa-icon svg { fill: rgba(255,255,255,.7); stroke: none; }
    .footer-col h4 { font-size: 10px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: rgba(255,255,255,.35); margin-bottom: 18px; }
    .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
