      border-top: 1px solid rgba(255,255,255,.06); padding-top: 24px;
      display: flex; align-items: center; justify-content: space-between;
      font-size: 13px; color: rgba(255,255,255,.3);
      flex-wrap: wrap; gap: 12px;
    }

    /* FLOATING WHATSAPP */
    .float-wa {
      position: fixed; bottom: 24px; right: 24px; z-index: 999;
      background: #25D366; color: var(--white);
      display: flex; align-items: center; gap: 8px;
      padding: 12px 20px; border-radius: 50px;
      font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 700;
      box-shadow: 0 8px 28px rgba(37,211,102,.4);
      text-decoration: none; transition: transform .2s, background .2s;
    }
    .float-wa:hover { background: #1FB855; transform: translateY(-2px); }
    .float-wa svg { width: 20px; height: 20px; stroke: var(--white); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    #toast {
      position: fixed; bottom: 90px; right: 24px; z-index: 9999;
      background: #1A3C2E; color: var(--white);
      padding: 14px 22px; border-radius: 12px;
      font-size: 14px; font-weight: 600; font-family: 'Poppins', sans-serif;
      box-shadow: 0 8px 28px rgba(0,0,0,.2);
      display: none; align-items: center; gap: 10px;
      border-left: 4px solid var(--orange);
    }
    #toast.show { display: flex; }

    /* RESPONSIVE */
    @media (max-width: 1100px) {
      .nav-links { gap: 12px; }
      .nav-links a { font-size: 13px; }
      .nav-inner > .btn { padding: 10px 14px; }
      .hero-right { flex-basis: 420px; }
      .services-grid { grid-template-columns: repeat(2,1fr); }
      .feature-grid { grid-template-columns: repeat(2,1fr); }
      .benefit-list { grid-template-columns: repeat(3,1fr); }
      .success-grid { grid-template-columns: repeat(3,1fr); }
      .usp-grid { grid-template-columns: repeat(3,1fr); }
      .footer-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 900px) {
      #hero { padding-top: 104px; }
      .hero-inner { flex-direction: column; gap: 32px; max-width: 100%; }
      .hero-right { flex: none; order: -1; width: min(360px, 100%); }
      .hero-left { width: 100%; }
      .hero-image-wrap { width: min(320px, 92vw); }
      .hero-circle-img { width: 88%; }
      .hero-name-card { left: 2%; bottom: 3%; font-size: 16px; padding: 12px 18px; }
