      .help-grid .help-card:nth-child(5) { grid-column: unset; }
      .steps { grid-template-columns: 1fr 1fr; }
      .steps::before { display: none; }
      .benefit-list { grid-template-columns: 1fr 1fr; }
      .success-grid { grid-template-columns: 1fr; }
