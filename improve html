  const WHATSAPP_NUMBER = '919148783991';
  const config = {
    title: 'LoklBiz | Business Growth Partner for Local & Made-in-India Businesses',
    whatsappIntro: 'Hi LoklBiz Team,',
    consultationLine: 'I would like a free consultation.',
    toastSent: "✅ Enquiry sent! We'll WhatsApp you shortly.",
    toastOpen: '✅ Opening WhatsApp — just tap Send.'
  };
  const DEFAULT_CONFIG = { ...config };
  let currentLang = 'en';
  let toastTimer = null;

  function showToast(message) {
    const toast = document.getElementById('toast');
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add('show');
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('show'), 3500);
  }

  function getWhatsAppMessage() {
    return [
      config.whatsappIntro,
      '',
      'I want to grow my local business with LoklBiz.',
      config.consultationLine
    ].join('\n');
  }

  function updateWhatsAppLinks() {
    const href = 'https://wa.me/' + WHATSAPP_NUMBER + '?text=' + encodeURIComponent(getWhatsAppMessage());
    document.querySelectorAll('a[href*="wa.me/"]').forEach((link) => {
      link.href = href;
      link.target = '_blank';
      link.rel = 'noopener';
    });
  }

  function translateDomText(map) {
    if (!map) return;
    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
    const nodes = [];
    while (walker.nextNode()) nodes.push(walker.currentNode);
    for (const n of nodes) {
      const raw = n.nodeValue;
      const trimmed = raw.trim();
      if (!trimmed) continue;
      const repl = map[trimmed];
      if (!repl) continue;
      const leading = raw.match(/^\s*/)?.[0] ?? '';
      const trailing = raw.match(/\s*$/)?.[0] ?? '';
      n.nodeValue = leading + repl + trailing;
    }
  }

  function setLanguage(next) {
    currentLang = next === 'hi' ? 'hi' : 'en';
    const codeEl = document.getElementById('langCode');
    if (codeEl) codeEl.textContent = currentLang === 'hi' ? 'English' : 'हिंदी';
    const mobileCodeEl = document.getElementById('mobileLangCode');
    if (mobileCodeEl) mobileCodeEl.textContent = currentLang === 'hi' ? 'English' : 'हिंदी';
    const mobileTextEl = document.querySelector('.mobile-lang-text');
    if (mobileTextEl) mobileTextEl.textContent = currentLang === 'hi' ? 'भाषा बदलें:' : 'Change Language:';

    if (currentLang === 'hi') {
      const hi = i18n.hi || {};
      if (hi.title) config.title = hi.title;
      if (hi.whatsappIntro) config.whatsappIntro = hi.whatsappIntro;
      if (hi.consultationLine) config.consultationLine = hi.consultationLine;
      if (hi.toastSent) config.toastSent = hi.toastSent;
      if (hi.toastOpen) config.toastOpen = hi.toastOpen;
      const ph = (hi.placeholders || {});
      document.querySelectorAll('input[placeholder], textarea[placeholder]').forEach((el) => {
        const cur = el.getAttribute('placeholder') || '';
        if (ph[cur]) el.setAttribute('placeholder', ph[cur]);
      });
    } else {
      Object.assign(config, DEFAULT_CONFIG);
      const enPh = (i18n.en && i18n.en.placeholders) ? i18n.en.placeholders : {};
      document.querySelectorAll('input[placeholder], textarea[placeholder]').forEach((el) => {
        const cur = el.getAttribute('placeholder') || '';
        if (enPh[cur]) el.setAttribute('placeholder', enPh[cur]);
      });
    }

    document.documentElement.lang = currentLang === 'hi' ? 'hi-IN' : 'en-IN';
    document.title = config.title;
    if (currentLang === 'hi') translateDomText(i18n.hi && i18n.hi.text ? i18n.hi.text : null);

    // Direct fix for "Grow Your Business" heading
    const gyText = document.querySelector('.grow-your-text');
    const gbText = document.querySelector('.grow-business-text');
    if (currentLang === 'hi') {
      if (gyText) gyText.textContent = 'अपना ';
      if (gbText) gbText.textContent = 'बिजनेस बढ़ाएं';
    } else {
      if (gyText) gyText.textContent = 'Grow Your ';
      if (gbText) gbText.textContent = 'Business';
    }

    updateWhatsAppLinks();
    safeStorage('loklbiz_lang', currentLang);
  }

  const savedLang = safeStorageGet('loklbiz_lang');
  setLanguage(savedLang === 'hi' ? 'hi' : 'en');

  function handleLanguageToggle() {
    const next = currentLang === 'hi' ? 'en' : 'hi';
    safeStorage('loklbiz_lang', next);
    location.reload();
  }

  const langBtn = document.getElementById('langToggle');
  if (langBtn) langBtn.addEventListener('click', handleLanguageToggle);

  const mobileLangBtn = document.getElementById('mobileLangToggle');
  if (mobileLangBtn) mobileLangBtn.addEventListener('click', handleLanguageToggle);

  updateWhatsAppLinks();

  // ─── Scroll / navbar ───────────────────────────────────────────────────────
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 20);
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });

  // ─── Mobile menu ───────────────────────────────────────────────────────────
  function toggleMobileMenu() {
    const nav = document.getElementById('mobileNav');
    nav.classList.toggle('open');
    document.body.style.overflow = nav.classList.contains('open') ? 'hidden' : '';
  }
  function closeMobileMenu() {
    document.getElementById('mobileNav').classList.remove('open');
    document.body.style.overflow = '';
  }

  document.addEventListener('click', (e) => {
    const mobileNav = document.getElementById('mobileNav');
    const hamburger = document.querySelector('.hamburger');
    if (mobileNav && mobileNav.classList.contains('open')) {
      if (!mobileNav.contains(e.target) && (!hamburger || !hamburger.contains(e.target))) {
        mobileNav.classList.remove('open');
        document.body.style.overflow = '';
      }
    }
  });

  // ─── FAQ Toggle ────────────────────────────────────────────────────────────
  function toggleFaq(btn) {
    const item = btn.parentElement;
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(el => {
      el.classList.remove('open');
      el.querySelector('.faq-q')?.setAttribute('aria-expanded', 'false');
    });
    if (!isOpen) {
      item.classList.add('open');
      btn.setAttribute('aria-expanded', 'true');
    }
  }

  document.querySelectorAll('.faq-q').forEach(btn => {
    btn.setAttribute('aria-expanded', btn.parentElement.classList.contains('open') ? 'true' : 'false');
  });

  // ─── Form submit ───────────────────────────────────────────────────────────
  function submitForm(e) {
    e.preventDefault();
    const f = e.target;
    const fields = f.querySelectorAll('input');
    const name     = fields[0].value.trim();
    const biz      = fields[1].value.trim();
    const phone    = fields[2].value.trim();
    const bizType  = f.querySelector('.form-select').value;
    const message  = f.querySelector('.form-textarea').value.trim();
    const lines = [
      config.whatsappIntro,
      '',
      'Name: ' + name,
      'Business: ' + biz,
      'Phone: ' + phone,
      'Business Type: ' + bizType,
      message ? 'Message: ' + message : '',
      '',
      config.consultationLine
    ].filter(Boolean).join('\n');
    window.open('https://wa.me/' + WHATSAPP_NUMBER + '?text=' + encodeURIComponent(lines), '_blank');
    showToast(config.toastOpen);
    f.reset();
  }

  // ─── Lazy image fade-in ────────────────────────────────────────────────────
  if ('IntersectionObserver' in window) {
    const imgObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('loaded');
          imgObserver.unobserve(entry.target);
        }
      });
    }, { rootMargin: '50px' });
    document.querySelectorAll('img[loading="lazy"]').forEach(img => imgObserver.observe(img));
  } else {
    document.querySelectorAll('img[loading="lazy"]').forEach(img => img.classList.add('loaded'));
  }
  document.querySelectorAll('img[loading="eager"]').forEach(img => img.classList.add('loaded'));

  // ─── Expose globals for inline handlers ───────────────────────────────────
  window.toggleMobileMenu = toggleMobileMenu;
  window.closeMobileMenu  = closeMobileMenu;
  window.toggleFaq        = toggleFaq;
  window.submitForm       = submitForm;
</script>
