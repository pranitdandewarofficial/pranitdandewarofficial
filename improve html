    .trusted-logos .logo-item:hover { opacity: 1; }
    .trusted-logos .logo-name { color: var(--white); font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 16px; letter-spacing: -.3px; line-height: 1; }
    .trusted-logos .logo-sub  { color: rgba(255,255,255,.4); font-size: 9px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; margin-top: 2px; }

