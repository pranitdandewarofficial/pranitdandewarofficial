      footer .footer-col ul { gap: 8px; }
      footer .footer-socials a { width: 40px; height: 40px; border-radius: 12px; }
      footer .footer-brand .logo-wrap { gap: 12px; }
      footer .footer-desc { margin-bottom: 16px; }
      .hero-h1 { font-size: clamp(1.7rem, 8vw, 2.25rem); line-height: 1.12; }
      .hero-desc { font-size: 15px; line-height: 1.6; margin-bottom: 26px; }
