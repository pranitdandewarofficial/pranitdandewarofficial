    .btn-submit:hover { background: var(--orange-dark); transform: translateY(-1px); }

    .info-title { font-size: 22px; font-weight: 800; color: var(--white); margin-bottom: 28px; }
    .info-items { display: flex; flex-direction: column; gap: 22px; }
    .info-item { display: flex; align-items: flex-start; gap: 14px; }
    .info-icon {
      width: 40px; height: 40px; border-radius: 12px;
      background: rgba(255,255,255,.1); display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .info-icon svg { width: 18px; height: 18px; stroke: var(--orange); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .info-lbl { font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.4); }
    .info-val  { font-size: 15px; font-weight: 600; color: var(--white); margin-top: 2px; }
    .socials { display: flex; gap: 10px; margin-top: 32px; padding-top: 28px; border-top: 1px solid rgba(255,255,255,.1); }
    .social-icon {
      width: 40px; height: 40px; border-radius: 50%;
      background: rgba(255,255,255,.1); display: flex; align-items: center; justify-content: center;
    }
    .social-icon:hover { background: rgba(249,115,22,.3); }
    .social-icon svg { width: 18px; height: 18px; stroke: var(--white); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    .lang-toggle {
      min-width: 86px; height: 40px; border-radius: 50px;
      border: 1px solid rgba(0,0,0,.08);
      background: rgba(255,255,255,.9);
      color: var(--text-dark);
      display: inline-flex; align-items: center; justify-content: center;
      cursor: pointer;
      transition: transform .15s, box-shadow .2s, background .2s;
      flex-shrink: 0;
    }
    .lang-toggle:hover { transform: translateY(-1px); box-shadow: 0 10px 22px rgba(0,0,0,.08); background: #fff; }
    .lang-toggle svg { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .lang-toggle .lang-code { font-size: 12px; font-weight: 800; letter-spacing: .02em; margin-left: 6px; }

    /* FOOTER */
    footer { background: var(--green-dark); padding: 48px 0 20px; border-top: 1px solid var(--green-mid); }
    .footer-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 52px; }
    .footer-brand .logo-wrap { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
    .footer-brand .logo-wrap img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
