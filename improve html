  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { overflow-x: hidden; }
    html, body { overflow-x: hidden !important; max-width: 100vw; }

    :root {
      --orange: #F97316;
      --orange-dark: #EA6B0A;
      --green-dark: #0D2B1F;
      --green-mid: #1A3C2E;
      --green-text: #1A6B3A;
      --cream: #FDF6EC;
      --cream-border: #E5DFD5;
      --text-dark: #1A1A1A;
      --text-mid: #4B5563;
      --text-light: #9CA3AF;
      --white: #ffffff;
    }

    html {
      scroll-behavior: smooth;
      overflow-x: hidden;
      max-width: 100%;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: var(--cream);
      color: var(--text-dark);
      overflow-x: hidden;
      max-width: 100%;
      width: 100%;
    }

    /* Prevent double-tap zoom on buttons/links */
    a, button, .btn, .faq-q, .hamburger, .lang-toggle {
      touch-action: manipulation;
    }

    h1,h2,h3,h4,h5,h6 { font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }

    a { text-decoration: none; color: inherit; }
    img { display: block; max-width: 100%; }
    button { cursor: pointer; border: none; background: none; font-family: inherit; }

    .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; overflow-x: hidden; }

    /* Performance: below-fold sections deferred rendering */
    #how, #solutions, #mission, #vision, #business-network, #collaborations, #success-stories, #testimonials, #about, #contact, footer {
      content-visibility: auto;
      contain-intrinsic-size: 0 600px;
    }
    #navbar {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      background: var(--cream);
      border-bottom: 1px solid var(--cream-border);
      padding: 14px 0;
      transition: box-shadow .3s;
    }
    #navbar.scrolled { box-shadow: 0 4px 24px rgba(0,0,0,.08); }
    .nav-inner {
      display: flex; align-items: center; justify-content: space-between; gap: 14px;
    }
    .nav-actions { display: flex; align-items: center; gap: 12px; }
    .nav-logo { display: flex; align-items: center; gap: 10px; cursor: pointer; }
    .nav-logo-mark {
      width: 46px; height: 46px; border-radius: 50%;
      overflow: hidden; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      background: #fff;
      border: 2px solid rgba(26,107,58,.14);
      clip-path: circle(50%);
    }
    .nav-logo img {
      width: 100%; height: 100%;
      object-fit: cover; object-position: center;
      border-radius: 50%;
      transform: scale(1.08);
    }
    .nav-logo-text .brand { font-family: 'Poppins', sans-serif; font-size: 20px; font-weight: 800; line-height: 1; }
    .nav-logo-text .brand .lokl { color: var(--orange); }
    .nav-logo-text .brand .biz  { color: var(--green-text); }
    .nav-logo-text .tagline { font-size: 9px; font-weight: 600; letter-spacing: .15em; text-transform: uppercase; color: #9CA3AF; margin-top: 2px; }
    .nav-links { display: flex; align-items: center; gap: 18px; }
    .nav-links a { font-size: 14px; font-weight: 500; color: var(--text-dark); transition: color .2s; }
    .nav-links a:hover { color: var(--orange); }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-family: 'Poppins', sans-serif; font-weight: 700; border-radius: 8px; cursor: pointer; transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); padding: 11px 20px; font-size: 14px; line-height: 1.2; text-align: center; position: relative; overflow: hidden; }
    .btn::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      border-radius: 50%;
      background: rgba(255,255,255,0.2);
      transform: translate(-50%, -50%);
      transition: width 0.6s ease, height 0.6s ease;
    }
    .btn:hover::before {
      width: 300px;
      height: 300px;
    }
    .btn:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,0.15); }
    .btn-orange { background: var(--orange); color: #fff; border: 2px solid var(--orange); box-shadow: 0 4px 14px rgba(249,115,22,.25); }
    .btn-orange:hover { background: var(--orange-dark); border-color: var(--orange-dark); box-shadow: 0 8px 24px rgba(249,115,22,.35); }
    .btn-outline { background: transparent; color: var(--text-dark); border: 2px solid var(--text-dark); }
    .btn-outline:hover { background: var(--text-dark); color: #fff; }
    .btn-green { background: var(--green-mid); color: #fff; border: 2px solid var(--green-mid); }
    .btn-green:hover { background: var(--green-dark); }
    .btn-pill { border-radius: 50px; }
    .btn-lg { padding: 14px 26px; font-size: 15px; }
    .hamburger { display: none; flex-direction: column; gap: 5px; padding: 4px; }
    .hamburger span { display: block; width: 24px; height: 2px; background: var(--text-dark); border-radius: 2px; transition: .3s; }
    .mobile-nav { display: none; flex-direction: column; background: var(--cream); border-top: 1px solid var(--cream-border); padding: 16px 24px; gap: 4px; }
    .mobile-nav a { font-size: 15px; font-weight: 500; padding: 10px 0; border-bottom: 1px solid var(--cream-border); color: var(--text-dark); }
    .mobile-nav a:last-child { border-bottom: none; }
    .mobile-nav .btn { margin-top: 10px; justify-content: center; }
    .mobile-nav.open { display: flex; }
    .mobile-lang-btn {
      width: 100%;
      margin-top: 10px;
      padding: 12px 14px;
      border-radius: 14px;
      border: 1px solid var(--cream-border);
      background: #fff;
      display: none;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 700;
      color: var(--text-dark);
      border-bottom: 1px solid var(--cream-border);
    }
    .mobile-lang-btn svg { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .mobile-lang-btn .mobile-lang-text { font-weight: 600; }
    .mobile-lang-btn .mobile-lang-code { font-size: 12px; font-weight: 800; letter-spacing: .12em; }

    /* HERO */
    #hero {
      padding: 120px 0 70px;
      background: var(--cream);
      position: relative;
      overflow-x: hidden;
      overflow-y: visible;
    }
    #hero::before {
      content: ''; position: absolute; top: -60px; right: -100px;
      width: 420px; height: 420px; border-radius: 50%;
      background: radial-gradient(circle, rgba(249,115,22,.09) 0%, transparent 70%);
      pointer-events: none;
    }
    #hero::after {
      content: ''; position: absolute; bottom: 0; left: -80px;
      width: 280px; height: 280px; border-radius: 50%;
      background: radial-gradient(circle, rgba(26,107,58,.07) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero-inner { display: flex; align-items: center; gap: 44px; }
    .hero-left { flex: 1; min-width: 0; }
    .hero-right { flex: 0 0 480px; position: relative; display: flex; align-items: center; justify-content: center; overflow: visible; }

    .badge-india {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--white); border: 1px solid var(--cream-border);
      color: var(--green-text); padding: 7px 16px; border-radius: 50px;
      font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
      margin-bottom: 24px; box-shadow: 0 2px 8px rgba(0,0,0,.06);
    }

    .hero-h1 {
      font-size: clamp(2rem, 3.7vw, 3.25rem);
      font-weight: 900; line-height: 1.1; margin-bottom: 24px;
      color: var(--text-dark);
    }
    .hero-h1 .accent { color: var(--orange); }

    .hero-desc {
      font-size: 17px; color: var(--text-mid); line-height: 1.7;
      border-left: 4px solid rgba(249,115,22,.35); padding-left: 16px;
      margin-bottom: 36px;
    }

    .hero-btns { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 40px; }

    .hero-stats {
      display: flex; flex-wrap: wrap; gap: 20px;
      padding-top: 24px; border-top: 1px solid var(--cream-border);
    }
    .stat-item { display: flex; align-items: center; gap: 10px; }
    .stat-icon { width: 36px; height: 36px; border-radius: 8px; background: var(--white); border: 1px solid var(--cream-border); display: flex; align-items: center; justify-content: center; }
    .stat-icon svg { width: 16px; height: 16px; }
    .stat-text .num { font-size: 14px; font-weight: 700; color: var(--text-dark); line-height: 1.2; }
    .stat-text .sub { font-size: 11px; color: var(--text-light); font-weight: 500; }

    .hero-image-wrap {
      position: relative; width: min(400px, 100%); aspect-ratio: 1;
      display: flex; align-items: center; justify-content: center;
      overflow: visible;
    }
    .hero-ring-outer {
      position: absolute; inset: 0; border-radius: 50%;
      border: 2px solid rgba(249,115,22,.2);
      animation: pulse-ring 3s ease-in-out infinite;
    }
    @keyframes pulse-ring {
      0%, 100% { transform: scale(1); opacity: 0.8; }
      50% { transform: scale(1.05); opacity: 0.5; }
    }
    .hero-ring-inner {
      position: absolute; inset: 20px; border-radius: 50%;
      border: 1px solid rgba(249,115,22,.12);
      animation: rotate-ring 20s linear infinite;
    }
    @keyframes rotate-ring {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    .hero-glow {
      position: absolute; inset: 40px; border-radius: 50%;
      background: radial-gradient(circle, rgba(249,115,22,.18) 0%, transparent 70%);
      animation: glow-pulse 4s ease-in-out infinite;
    }
    @keyframes glow-pulse {
      0%, 100% { opacity: 0.6; transform: scale(1); }
      50% { opacity: 0.9; transform: scale(1.08); }
    }
    .hero-circle-img {
      position: relative; width: 88%; aspect-ratio: 1; border-radius: 50%;
      overflow: hidden; border: 6px solid var(--white);
      box-shadow: 0 20px 60px rgba(0,0,0,.14); z-index: 2;
      transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
      animation: float-img 6s ease-in-out infinite;
    }
    @keyframes float-img {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }
    .hero-circle-img:hover {
      transform: scale(1.05) rotate(2deg);
    }
    .hero-circle-img img { width: 100%; height: 100%; object-fit: cover; object-position: 60% 10%; aspect-ratio: 1/1; }
    .hero-name-card {
      position: absolute;
      bottom: 5%;
      left: -4%;
      background: var(--green-mid);
      color: var(--white);
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 14px;
      padding: 14px 20px;
      box-shadow: 0 16px 40px rgba(0,0,0,.2);
      z-index: 10;
      font-family: 'Poppins', sans-serif;
      line-height: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      text-align: center;
    }

    .hero-name-card .hero-name { font-size: 18px; font-weight: 800; }
    .hero-name-card .hero-sub  { font-size: 12px; font-weight: 600; opacity: 0.95; }

    /* TRUSTED BY */
    #trusted {
      background: var(--green-dark); padding: 40px 0;
      border-top: 1px solid #1A3C2E; border-bottom: 1px solid #1A3C2E;
      overflow: hidden;
    }
    .trusted-label {
      text-align: center; font-size: 10px; font-weight: 700;
      letter-spacing: .22em; text-transform: uppercase; color: rgba(255,255,255,.4);
      margin-bottom: 24px;
