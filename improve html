    .svc-title { font-size: 15px; font-weight: 700; color: var(--text-dark); margin-bottom: 4px; }
    .svc-desc  { font-size: 13px; color: var(--text-mid); line-height: 1.6; }
    .svc-banner {
      margin-top: 32px; background: var(--white); border: 1px solid rgba(249,115,22,.2);
      border-radius: 16px; padding: 20px 28px; text-align: center;
    }
    .svc-banner p { font-size: 18px; font-weight: 600; font-family: 'Poppins', sans-serif; color: var(--text-dark); }
    .svc-banner span { color: var(--orange); }

    /* GROWTH CONTENT SECTIONS */
    .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .feature-card {
      background: var(--white); border: 1px solid var(--cream-border);
      border-radius: 16px; padding: 26px 24px;
      transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      will-change: transform, box-shadow;
    }
    .feature-card:hover { 
      border-color: rgba(249,115,22,.5); 
      box-shadow: 0 16px 40px rgba(249,115,22,.12); 
      transform: translateY(-8px) scale(1.02); 
    }
    .feature-card:hover .feature-kicker {
      transform: scale(1.05);
      display: inline-block;
      transition: transform 0.3s ease;
    }
    .feature-kicker { font-size: 12px; font-weight: 800; color: var(--orange); margin-bottom: 10px; letter-spacing: .12em; text-transform: uppercase; }
    .feature-title { font-size: 18px; font-weight: 800; color: var(--text-dark); margin-bottom: 8px; font-family: 'Poppins', sans-serif; }
    .feature-desc { font-size: 14px; color: var(--text-mid); line-height: 1.7; }
    .split-section { background: var(--white); border-top: 1px solid var(--cream-border); border-bottom: 1px solid var(--cream-border); }
    .statement-card {
      max-width: 880px; margin: 0 auto; background: var(--cream);
      border: 1px solid var(--cream-border); border-radius: 16px;
      padding: 34px; text-align: center;
    }
    .statement-card p { font-size: 18px; color: var(--text-mid); line-height: 1.75; }
    .benefit-list { list-style: none; display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin-top: 28px; }
    .benefit-list li {
      background: var(--white); border: 1px solid var(--cream-border);
      border-radius: 12px; padding: 14px 12px; text-align: center;
      font-size: 13px; font-weight: 700; color: var(--text-dark);
    }
    .success-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .success-card {
      background: var(--green-dark); color: var(--white); border-radius: 16px;
      padding: 28px 24px; text-align: center; border: 1px solid rgba(255,255,255,.08);
      transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      will-change: transform, box-shadow;
    }
    .success-card:hover {
      transform: translateY(-8px) scale(1.03);
      box-shadow: 0 16px 40px rgba(249,115,22,.2);
      border-color: rgba(249,115,22,.4);
    }
    .success-card .big { font-family: 'Poppins', sans-serif; font-size: 34px; font-weight: 900; color: var(--orange); line-height: 1; transition: transform 0.3s ease; }
    .success-card:hover .big { transform: scale(1.15); }
    .success-card .lbl { margin-top: 8px; font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.65); }

    /* WHO WE HELP */
    #solutions { background: var(--white); border-top: 1px solid var(--cream-border); border-bottom: 1px solid var(--cream-border); }
    .help-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .help-grid .help-card:nth-child(4) { grid-column: 1 / 2; }
    .help-grid .help-card:nth-child(5) { grid-column: 2 / 3; }
    .help-card {
      background: var(--cream); border: 1px solid var(--cream-border);
      border-radius: 16px; padding: 32px 24px; text-align: center;
      transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      will-change: transform, box-shadow;
    }
    .help-card:hover { 
      border-color: rgba(249,115,22,.5); 
      box-shadow: 0 16px 40px rgba(249,115,22,.12); 
      transform: translateY(-8px) scale(1.02); 
    }
    .help-card:hover .help-emoji {
      transform: scale(1.15) rotate(5deg);
      transition: transform 0.3s ease;
    }
    .help-emoji { font-size: 38px; margin-bottom: 14px; }
    .help-title { font-size: 16px; font-weight: 700; color: var(--text-dark); margin-bottom: 8px; }
    .help-desc  { font-size: 13px; color: var(--text-mid); line-height: 1.65; }

    /* HOW IT WORKS */
    #how { background: var(--cream); }
    .steps { display: grid; grid-template-columns: repeat(5,1fr); gap: 24px; position: relative; }
    .steps::before {
      content: '';
      position: absolute; top: 44px; left: 10%; right: 10%;
      height: 1px; background: linear-gradient(to right, transparent, rgba(249,115,22,.3), transparent);
    }
    .step { display: flex; flex-direction: column; align-items: center; text-align: center; }
    .step-icon-wrap { position: relative; margin-bottom: 20px; transition: transform 0.3s ease; }
    .step:hover .step-icon-wrap { transform: translateY(-6px); }
    .step-icon {
      width: 88px; height: 88px; border-radius: 16px;
      background: var(--white); border: 1px solid var(--cream-border);
      box-shadow: 0 4px 16px rgba(0,0,0,.06);
      display: flex; align-items: center; justify-content: center;
      transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .step:hover .step-icon {
      box-shadow: 0 12px 32px rgba(249,115,22,.2);
      border-color: rgba(249,115,22,.4);
      transform: scale(1.08);
    }
    .step-icon svg { width: 36px; height: 36px; stroke: var(--orange); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: stroke 0.3s ease; }
    .step:hover .step-icon svg { stroke: var(--orange-dark); transform: scale(1.1); }
    .step-num {
      position: absolute; top: -10px; right: -10px;
      width: 30px; height: 30px; border-radius: 50%;
      background: var(--green-text); color: var(--white);
      font-family: 'Poppins', sans-serif; font-size: 11px; font-weight: 800;
      display: flex; align-items: center; justify-content: center;
      border: 2px solid var(--cream);
      transition: transform 0.3s ease;
    }
    .step:hover .step-num { transform: scale(1.15) rotate(-5deg); }
    .step-title { font-size: 16px; font-weight: 700; color: var(--text-dark); margin-bottom: 6px; }
    .step-desc  { font-size: 13px; color: var(--text-mid); line-height: 1.65; }

    /* TESTIMONIALS */
    #testimonials { background: var(--white); }
    .test-inner { display: flex; gap: 64px; align-items: flex-start; }
    .test-left { flex: 0 0 420px; position: relative; }
    .test-right { flex: 1; }

    .photo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .photo-grid img { border-radius: 16px; object-fit: cover; width: 100%; border: 1px solid var(--cream-border); box-shadow: 0 4px 12px rgba(0,0,0,.06); }
    .photo-grid .ph1 { height: 180px; object-position: top; }
    .photo-grid .ph2 { height: 180px; object-position: top; }
    .photo-grid .ph3 { grid-column: 1/-1; height: 160px; object-position: center; }

    .stats-card {
      margin-top: 20px;
      background: var(--text-dark); border-radius: 16px; padding: 20px 28px;
      display: flex; justify-content: space-between; gap: 20px;
      box-shadow: 0 16px 40px rgba(0,0,0,.18);
      max-width: 100%;
      overflow: hidden;
    }
    .stat-col { text-align: center; }
    .stat-col .big { font-family: 'Poppins', sans-serif; font-size: 26px; font-weight: 900; color: var(--orange); line-height: 1; }
    .stat-col .lbl { font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.35); margin-top: 4px; }

    .test-title { font-size: clamp(1.5rem,3vw,2.2rem); font-weight: 800; color: var(--text-dark); margin-bottom: 28px; }
    .test-cards { display: flex; flex-direction: column; gap: 18px; }
    .test-card {
      background: var(--cream); border: 1px solid var(--cream-border);
      border-radius: 16px; padding: 22px 24px; position: relative; overflow: hidden;
      transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      will-change: transform, box-shadow;
    }
    .test-card:hover { 
      border-color: rgba(249,115,22,.5); 
      box-shadow: 0 12px 32px rgba(249,115,22,.12); 
      transform: translateY(-6px) scale(1.02); 
    }
    .test-card:hover .quote-bg {
      transform: scale(1.1) rotate(5deg);
      transition: transform 0.4s ease;
    }
    .test-card .quote-bg {
      position: absolute; top: 8px; right: 16px;
      font-size: 80px; line-height: 1; color: rgba(249,115,22,.08);
      font-family: Georgia, serif; pointer-events: none;
      transition: transform 0.4s ease;
    }
    .stars { display: flex; gap: 2px; margin-bottom: 10px; }
    .stars svg { width: 15px; height: 15px; fill: var(--orange); }
    .test-quote { font-size: 14px; color: var(--text-mid); line-height: 1.7; font-style: italic; margin-bottom: 12px; }
    .test-author { font-size: 14px; font-weight: 700; color: var(--text-dark); }
    .test-role   { font-size: 12px; color: var(--text-light); margin-top: 2px; }

    /* CONTACT */
    #contact { background: var(--white); border-top: 1px solid var(--cream-border); }
